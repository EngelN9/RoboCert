* text=auto
*.md text eol=lf whitespace=-trailing-space
*.py text eol=lf
*.json text eol=lf
*.sha256 text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
VERSION text eol=lf

# Proof-assistant sources and toolchain pins. All three ecosystems are Unix-centric and
# their tooling is fragile about CRLF; keep these LF in the working tree too, not just in
# the repository.
*.lean text eol=lf
*.v text eol=lf
*.thy text eol=lf
lean-toolchain text eol=lf
_CoqProject text eol=lf
ROOT text eol=lf

# Files whose SHA-256 is recorded in formal/attestations/*.json. Their digest IS their
# content, so a platform-dependent line ending would make the same commit hash differently
# on Windows and Linux and break scripts/check_attestations.py on one of them. Any new
# digest-bearing file MUST be pinned here.
formal/attestations/statements/* text eol=lf
